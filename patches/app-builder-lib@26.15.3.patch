@@ -7,6 +7,14 @@
 
 !insertmacro MUI_PAGE_INSTFILES
 !ifdef BUILD_UNINSTALLER
+  # DeepSeekGUI local patch: MUI page-hook defines are consumed first-come-first-
+  # served, and the installer page above also expands in the uninstaller
+  # build -- so an un. SHOW hook defined up front gets eaten by a page that
+  # never shows, failing the compile. This seam lets user scripts define the
+  # uninstall page's hooks after the installer page has expanded.
+  !ifmacrodef customUnpageInstfilesPre
+    !insertmacro customUnpageInstfilesPre
+  !endif
   !insertmacro MUI_UNPAGE_INSTFILES
 !endif
 
